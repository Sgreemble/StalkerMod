--// LIMPIEZA DE UNA EJECUCION ANTERIOR
if getgenv().QuadrupedalStalkerCleanup then
	pcall(getgenv().QuadrupedalStalkerCleanup)
end
local Running = true
local Connections = {}
local ActiveTweens = {}
local function TrackConnection(connection)
	table.insert(Connections, connection)
	return connection
end
local function Cleanup()
	Running = false
	for _, connection in ipairs(Connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	for _, tween in ipairs(ActiveTweens) do
		pcall(function()
			tween:Cancel()
		end)
	end
	if getgenv().QuadrupedalStalkerCleanup == Cleanup then
		getgenv().QuadrupedalStalkerCleanup = nil
	end
end
getgenv().QuadrupedalStalkerCleanup = Cleanup
--// PERSONAJE
local function GetCharacter()
	local character = Player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or humanoid.Health <= 0 then
		return nil
	end
	return character, humanoid, root
end
--// CREAR STALKELING AUTOMATICAMENTE
local function CreateStalkeling()
	local model = Instance.new("Model")
	model.Name = MODEL_NAME
	local root = Instance.new("Part")
	root.Name = "StalkerRoot"
	root.Size = Vector3.new(2, 2, 2)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.CastShadow = false
	root.Parent = model
	model.PrimaryPart = root
	local attachment = Instance.new("Attachment")
	attachment.Name = "StalkerAttachment"
	attachment.Parent = root
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "StalkerTexture"
	emitter.Texture = TEXTURE_ID
	emitter.Lifetime = NumberRange.new(0.1, 0.1)
	emitter.Rate = 60
	emitter.Speed = NumberRange.new(0, 0)
	emitter.Shape = Enum.ParticleEmitterShape.Sphere
	emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
	emitter.LockedToPart = true
	emitter.Rotation = NumberRange.new(0, 0)
	emitter.RotSpeed = NumberRange.new(0, 0)
	emitter.SpreadAngle = Vector2.new(0, 0)
	emitter.LightInfluence = 0
	emitter.ZOffset = 1
	emitter.Size = NumberSequence.new(5)
	emitter.Transparency = NumberSequence.new(0)
	emitter.Parent = attachment
	-- Sonido de dash
	local dashSound = Instance.new("Sound")
	dashSound.Name = "DashSound"
	dashSound.SoundId = DASH_SOUND_ID
	dashSound.Volume = 1
	dashSound.PlaybackSpeed = 1
	dashSound.Parent = root
	model.Parent = Workspace
	return model, root, emitter, dashSound
end
local StalkerModel, StalkerRoot, StalkerEmitter, DashSound = CreateStalkeling()
