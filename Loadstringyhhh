--// POSICION INICIAL
local function GetInitialPosition()
	local _, _, root = GetCharacter()
	if not root then
		return nil
	end
	return root.CFrame * CFrame.new(0, 0, SPAWN_DISTANCE)
end
local initialCFrame = GetInitialPosition()
if initialCFrame then
	StalkerModel:PivotTo(initialCFrame)
end
--// INICIAR EL ENTITY SPAWNER
local runSuccess, runError = pcall(function()
	Entity:Run()
end)
if not runSuccess then
	Entity:Despawn()
	Cleanup()
	warn("[Quadrupedal Stalker] Error al iniciar:", runError)
	return
end
--// MOVIMIENTO PERSONALIZADO
local IsDashing = false
local LastDash = 0
local LastLookState = false
local StartTime = os.clock()
local function IsPlayerLookingAtStalker(root)
	local camera = Workspace.CurrentCamera
	if not camera or not StalkerRoot or not StalkerRoot.Parent then
		return false
	end
	local offset = StalkerRoot.Position - camera.CFrame.Position
	if offset.Magnitude <= 0 then
		return true
	end
	local direction = offset.Unit
	local dot = camera.CFrame.LookVector:Dot(direction)
	if dot < 0.65 then
		return false
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {
		Player.Character,
		StalkerModel
	}
	local result = Workspace:Raycast(
		camera.CFrame.Position,
		offset,
		params
	)
	return result == nil
end
local function SmoothDash(targetCFrame)
	if IsDashing or not StalkerModel.Parent then
		return
	end
	IsDashing = true
	-- Reproducir sonido de dash
	if DashSound then
		DashSound:Play()
	end
	local startCFrame = StalkerModel:GetPivot()
	local elapsed = 0
	while Running and elapsed < DASH_TIME do
		local dt = RunService.Heartbeat:Wait()
		elapsed += dt
		local alpha = math.clamp(elapsed / DASH_TIME, 0, 1)
		alpha = alpha * alpha * (3 - 2 * alpha)
		if not StalkerModel.Parent then
			break
		end
		StalkerModel:PivotTo(startCFrame:Lerp(targetCFrame, alpha))
	end
	if StalkerModel.Parent then
		StalkerModel:PivotTo(targetCFrame)
	end
	IsDashing = false
end
local function GetDashTarget(root)
	local currentPosition = StalkerModel:GetPivot().Position
	local playerPosition = root.Position
	local towardPlayer = playerPosition - currentPosition
	local distance = towardPlayer.Magnitude
	if distance < 0.1 then
		return StalkerModel:GetPivot()
	end
	local moveDistance = math.min(
		DASH_DISTANCE,
		math.max(0, distance - 2)
	)
	local newPosition = currentPosition + towardPlayer.Unit * moveDistance
	return CFrame.lookAt(
		newPosition,
		playerPosition
	)
end
--// BUCLE PRINCIPAL
task.spawn(function()
	while Running do
		if os.clock() - StartTime >= ENCOUNTER_TIME then
			break
		end
		local character, humanoid, root = GetCharacter()
		if character and root and StalkerModel.Parent then
			local looking = IsPlayerLookingAtStalker(root)
			if looking then
				LastLookState = true
			else
				if os.clock() - LastDash >= DASH_COOLDOWN and not IsDashing then
					LastDash = os.clock()
					local target = GetDashTarget(root)
					task.spawn(function()
						SmoothDash(target)
					end)
				end
				LastLookState = false
			end
		end
		task.wait(0.05)
	end
	--// FINALIZAR ENCUENTRO
	Cleanup()
	if Entity then
		pcall(function()
			Entity:Despawn()
		end)
	end
	if StalkerModel and StalkerModel.Parent then
		StalkerModel:Destroy()
	end
	print("[Quadrupedal Stalker] Encuentro finalizado. Duración: " .. math.floor(ENCOUNTER_TIME) .. " segundos.")
end)
print("[Quadrupedal Stalker] Beta 1 iniciada. Duración del encuentro: " .. math.floor(ENCOUNTER_TIME) .. " segundos.")
